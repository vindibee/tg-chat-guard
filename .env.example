# ============================ Telegram ====================================
BOT_TOKEN=123456:ABC-DEF_your_token_here
DROP_PENDING_UPDATES=true

# ============================ Инфраструктура ==============================
# Локальный запуск без Docker: SQLite и Redis на localhost.
# В docker-compose эти два значения ПЕРЕОПРЕДЕЛЯЮТСЯ и собираются из POSTGRES_*
# и REDIS_PASSWORD ниже — править их для Docker не нужно.
# Prod без Docker: postgresql+asyncpg://user:pass@localhost:5432/tgmod
DATABASE_URL=sqlite+aiosqlite:///./moderation.db
REDIS_URL=redis://localhost:6379/0

# ============================ Docker Compose ==============================
# Пароли — только буквы и цифры: они подставляются в URL подключения.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_DB=tgmod
POSTGRES_USER=tgmod
POSTGRES_PASSWORD=change_me_postgres_password
REDIS_PASSWORD=change_me_redis_password
REDIS_NAMESPACE=tgmod
WHITELIST_CACHE_TTL=900
DB_ECHO=false
# Накатывать миграции при старте. false — если схему обновляет деплой
# отдельным шагом: alembic upgrade head
RUN_MIGRATIONS_ON_STARTUP=true

# ============================ Логирование =================================
LOG_LEVEL=INFO
LOG_JSON=true

# ============================ Доверенные сущности =========================
# Бот Флибусты — полный иммунитет к проверкам.
FLIBUSTA_BOT_ID=
FLIBUSTA_USERNAME=flibustafreebookbot

# Статический белый список (через запятую): системные боты и сервисные аккаунты.
STATIC_WHITELIST_IDS=
STATIC_WHITELIST_USERNAMES=

# Суперадмины бота: правят глобальный белый список в любом чате.
SUPER_ADMIN_IDS=

TRUST_CHAT_ADMINS=true
TRUST_ANONYMOUS_ADMINS=true

# ============================ Разбор срабатываний =========================
# Приватный чат модерации: туда уходит карточка по каждому срабатыванию
# с кнопками «Не спам» / «Верно» / «В белый список».
# Бот должен быть участником этого чата. Без него ложные срабатывания невидимы.
ADMIN_LOG_CHAT_ID=

# Сколько чистых сообщений подряд делают участника «одобренным».
# Одобренные не проверяются вовсе — главный приём против ложных срабатываний.
APPROVED_AFTER_MESSAGES=7
# Пока сообщений меньше — участник считается новичком (+1 к спам-скору).
NEW_MEMBER_MESSAGES=5
# Проверять всех, включая одобренных. Включать только во время атаки.
PARANOID_MODE=false
# Возвращать текст в чат при откате ложного срабатывания.
RESTORE_ON_FALSE_POSITIVE=true

# ============================ Блок-листы ==================================
# Публичные реестры спамеров. Попадание — сигнал с весом, а не приговор:
# базы ошибаются, поэтому автобан по умолчанию выключен.
REPUTATION_ENABLED=true
# lols — онлайн-запрос, cas_export — снимок списка (~1.3 млн id, ~10 МБ памяти)
REPUTATION_PROVIDERS=lols,cas_export
REPUTATION_WEIGHT=5.0
REPUTATION_AUTOBAN=false
REPUTATION_TIMEOUT=2.0
# Как часто обновлять снимок CAS, сек. (12 часов)
CAS_SYNC_INTERVAL=43200
REPUTATION_CACHE_TTL=86400

# ============================ Массовая очистка ============================
# Команда /clean (она же /purge) — только для админов с правом удаления.
CLEAN_ENABLED=true
# Глубина для «/clean all»
CLEAN_DEFAULT_DEPTH=1000
# Жёсткий потолок: защита от опечатки вида /clean 999999
CLEAN_MAX_DEPTH=5000
# Начиная с этой глубины бот спросит подтверждение кнопкой
CLEAN_CONFIRM_THRESHOLD=200
# Пауза между пакетами по 100 сообщений, сек. — страховка от FloodWait
CLEAN_BATCH_PAUSE=0.3
# Через сколько секунд убрать отчёт об очистке и саму команду
CLEAN_NOTICE_TTL=5

# Удалять «мусорные» ответы книжного бота: «не найдено книг» и ответы
# на сообщения, которые антиспам уже удалил. Сам бот при этом неприкосновенен.
FLIBUSTA_CLEANUP=true

# ============================ Служебные сообщения =========================
# Какие группы служебных сообщений удалять. Доступно:
#   join      — вступил в группу
#   leave     — вышел из группы
#   title     — сменилось название чата
#   photo     — сменилась аватарка или фон
#   pin       — «закрепил сообщение» (по умолчанию НЕ удаляется)
#   videochat — видеочат начался/закончился
#   forum     — создание и правка тем форума
#   boost     — буст чата
#   giveaway  — розыгрыши
#   gift      — подарки
#   created   — создание группы
#   other     — остальной служебный шум
# Особые значения: all (всё) и none (ничего).
# Платежи не удаляются НИКОГДА, даже при all.
SERVICE_CLEANUP=join,leave,title,photo,videochat,boost,created,forum,giveaway,gift,other

# ============================ Дубликаты ===================================
# Одинаковый текст от РАЗНЫХ участников — признак рассылки. Ловит спам,
# в котором нет ни ссылок, ни стоп-слов.
DUPLICATE_ENABLED=true
# Сколько разных авторов одного текста считаются рассылкой
DUPLICATE_THRESHOLD=3
# Окно наблюдения, сек.
DUPLICATE_WINDOW=3600
# Короткие сообщения не проверяются: «спасибо» и «ап» совпадают у всех
DUPLICATE_MIN_LENGTH=40
DUPLICATE_WEIGHT=4.0

# ============================ Упоминания ботов ============================
# Спам-сетки рекламируют ботов: «h0t vide0s on this bot @xxx_bot».
# Упоминание стороннего бота (@..._bot, t.me/...bot) — жёсткий фактор с этим
# весом. Одно упоминание ниже DELETE_THRESHOLD (советовать ботов в чате можно),
# но вместе с любой тематикой или призывом «переходи в бота» — удаление.
# Доверенные боты (FLIBUSTA_USERNAME, STATIC_WHITELIST_USERNAMES) не учитываются.
# Поставьте >= DELETE_THRESHOLD, чтобы удалять ЛЮБОЕ упоминание стороннего бота.
BOT_MENTION_WEIGHT=4.5
# Надбавка, если бота рекламирует новичок (< NEW_MEMBER_MESSAGES сообщений).
# 4.5 + 2.0 = 6.5 — удаление. 0 — выключить (новичкам можно советовать ботов).
NEWCOMER_PROMO_WEIGHT=2.0
# Спам-сети постят один бот раз в час, меняя текст. Каждое предыдущее упоминание
# того же бота тем же автором за окно добавляет вес (не больше трёх раз):
# 1-й раз — удаление, 2-й — мьют или бан.
PROMO_REPEAT_WEIGHT=4.0
PROMO_REPEAT_WINDOW=86400

# ============================ Жалобы участников ===========================
REPORT_ENABLED=true
# Сколько разных участников должны пожаловаться, чтобы позвать админов
REPORT_THRESHOLD=2

# ============================ Антиспам ====================================
# Наказывать только если стоп-слова совмещены со спам-фактором
# (ссылка, инвайт, рефкод, призыв к действию, упоминание постороннего канала).
REQUIRE_SPAM_FACTOR=true

DELETE_THRESHOLD=6.0
MUTE_THRESHOLD=9.0
BAN_THRESHOLD=15.0        # автобан — только для очевидного
MUTE_DURATION=3600

# Домены, ссылки на которые не считаются спам-фактором.
SAFE_DOMAINS=flibusta.is,flibusta.site,fantlab.ru,author.today,litres.ru,goodreads.com,libgen.is,wikipedia.org

# Рекомендуется false: разбор идёт в ADMIN_LOG_CHAT_ID, а чат не засоряется.
NOTIFY_CHAT=false
NOTIFY_TTL=20

# Режим наблюдения: считать и логировать, но ничего не удалять.
# Первую неделю держите true и разбирайте карточки в админ-чате.
DRY_RUN=false
