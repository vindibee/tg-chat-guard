# ============================ Telegram ====================================
BOT_TOKEN=123456:ABC-DEF_your_token_here
DROP_PENDING_UPDATES=true

# ============================ Инфраструктура ==============================
# Prod: postgresql+asyncpg://user:pass@localhost:5432/tgmod
DATABASE_URL=sqlite+aiosqlite:///./moderation.db
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=tgmod
WHITELIST_CACHE_TTL=900
DB_ECHO=false
# Накатывать миграции при старте. false — если схему обновляет деплой
# отдельным шагом: alembic upgrade head
RUN_MIGRATIONS_ON_STARTUP=true

# ============================ Логирование =================================
LOG_LEVEL=INFO
LOG_JSON=true

# ============================ Доверенные сущности =========================
# Бот Флибусты — полный иммунитет к проверкам.
FLIBUSTA_BOT_ID=
FLIBUSTA_USERNAME=flibustafreebookbot

# Статический белый список (через запятую): системные боты и сервисные аккаунты.
STATIC_WHITELIST_IDS=
STATIC_WHITELIST_USERNAMES=

# Суперадмины бота: правят глобальный белый список в любом чате.
SUPER_ADMIN_IDS=

TRUST_CHAT_ADMINS=true
TRUST_ANONYMOUS_ADMINS=true

# ============================ Разбор срабатываний =========================
# Приватный чат модерации: туда уходит карточка по каждому срабатыванию
# с кнопками «Не спам» / «Верно» / «В белый список».
# Бот должен быть участником этого чата. Без него ложные срабатывания невидимы.
ADMIN_LOG_CHAT_ID=

# Сколько чистых сообщений подряд делают участника «одобренным».
# Одобренные не проверяются вовсе — главный приём против ложных срабатываний.
APPROVED_AFTER_MESSAGES=7
# Пока сообщений меньше — участник считается новичком (+1 к спам-скору).
NEW_MEMBER_MESSAGES=5
# Проверять всех, включая одобренных. Включать только во время атаки.
PARANOID_MODE=false
# Возвращать текст в чат при откате ложного срабатывания.
RESTORE_ON_FALSE_POSITIVE=true

# ============================ Блок-листы ==================================
# Публичные реестры спамеров. Попадание — сигнал с весом, а не приговор:
# базы ошибаются, поэтому автобан по умолчанию выключен.
REPUTATION_ENABLED=true
# lols — онлайн-запрос, cas_export — снимок списка (~1.3 млн id, ~10 МБ памяти)
REPUTATION_PROVIDERS=lols,cas_export
REPUTATION_WEIGHT=5.0
REPUTATION_AUTOBAN=false
REPUTATION_TIMEOUT=2.0
# Как часто обновлять снимок CAS, сек. (12 часов)
CAS_SYNC_INTERVAL=43200
REPUTATION_CACHE_TTL=86400

# ============================ Дубликаты ===================================
# Одинаковый текст от РАЗНЫХ участников — признак рассылки. Ловит спам,
# в котором нет ни ссылок, ни стоп-слов.
DUPLICATE_ENABLED=true
# Сколько разных авторов одного текста считаются рассылкой
DUPLICATE_THRESHOLD=3
# Окно наблюдения, сек.
DUPLICATE_WINDOW=3600
# Короткие сообщения не проверяются: «спасибо» и «ап» совпадают у всех
DUPLICATE_MIN_LENGTH=40
DUPLICATE_WEIGHT=4.0

# ============================ Жалобы участников ===========================
REPORT_ENABLED=true
# Сколько разных участников должны пожаловаться, чтобы позвать админов
REPORT_THRESHOLD=2

# ============================ Антиспам ====================================
# Наказывать только если стоп-слова совмещены со спам-фактором
# (ссылка, инвайт, рефкод, призыв к действию, упоминание постороннего канала).
REQUIRE_SPAM_FACTOR=true

DELETE_THRESHOLD=6.0
MUTE_THRESHOLD=9.0
BAN_THRESHOLD=15.0        # автобан — только для очевидного
MUTE_DURATION=3600

# Домены, ссылки на которые не считаются спам-фактором.
SAFE_DOMAINS=flibusta.is,flibusta.site,fantlab.ru,author.today,litres.ru,goodreads.com,libgen.is,wikipedia.org

# Рекомендуется false: разбор идёт в ADMIN_LOG_CHAT_ID, а чат не засоряется.
NOTIFY_CHAT=false
NOTIFY_TTL=20

# Режим наблюдения: считать и логировать, но ничего не удалять.
# Первую неделю держите true и разбирайте карточки в админ-чате.
DRY_RUN=false
